# ЗАДАНИЕ 8
def calculate_sum(numbers):
    total = 0
    for n in numbers:
        total += n
    return total


def find_min(numbers):
    minimum = numbers[0]
    for n in numbers:
        if n < minimum:
            minimum = n
    return minimum


def find_max(numbers):
    maximum = numbers[0]
    for n in numbers:
        if n > maximum:
            maximum = n
    return maximum


data = [5, 8, 2, 10, 4]
print(calculate_sum(data))  # 29
print(find_min(data))       # 2
print(find_max(data))       # 10

# Сравнение со встроенными
print(sum(data), min(data), max(data))



