# ЗАДАНИЕ 2
def calculate_rectangle(width, height):
    return width * height


def calculate_perimeter(width, height):
    return 2 * (width + height)


def describe_rectangle(width, height, unit="cm"):
    print(f"Прямоугольник: {width} {unit} x {height} {unit}")
    print(f"Площадь: {calculate_rectangle(width, height)} {unit}²")
    print(f"Периметр: {calculate_perimeter(width, height)} {unit}")


# Вызов без unit — используется "cm"
describe_rectangle(5, 3)

# Вызов с unit — используется "м"
describe_rectangle(2, 4, unit="м")




